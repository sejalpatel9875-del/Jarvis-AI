# ==============================================================================
# J.A.R.V.I.S. AI OS — Enterprise Production Environment Variables Template
# Copy this file to '.env' and fill in your production API keys and database credentials.
# ==============================================================================

# --- Server & Environment Configuration ---
ENVIRONMENT=production          # Options: production, staging, development
PORT=8000
SECRET_KEY=generate_a_random_jwt_secret_key_here
CORS_ORIGINS=https://yourdomain.com,http://localhost:3000

# --- Database & Caching ---
# SQLite default fallback: sqlite:///./memory/jarvis.db
# PostgreSQL production example: postgresql://user:password@localhost:5432/jarvis_db
DATABASE_URL=sqlite:///./memory/jarvis.db
REDIS_URL=redis://localhost:6379/0

# --- AI LLM Providers & API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Security & Authentication ---
JARVIS_API_KEY=your_master_api_key_here

# --- Voice & Audio Engine (Optional) ---
TTS_VOICE=en-US-GuyNeural
WAKE_WORD=jarvis
