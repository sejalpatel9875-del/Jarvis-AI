# Gemini API Key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here

# Default TTS voice settings (edge-tts voice names)
# English options: en-US-GuyNeural, en-US-AvaNeural, en-GB-SoniaNeural
# Hindi options: hi-IN-MadhurNeural, hi-IN-SwaraNeural
TTS_VOICE=en-US-GuyNeural

# Wake word for Jarvis
WAKE_WORD=jarvis
