# ==============================================================================
# J.A.R.V.I.S. AI OS — Enterprise Production Environment Variables Template
# Copy this file to '.env' and fill in your production API keys and database credentials.
# ==============================================================================

# --- Server & Environment Configuration ---
ENVIRONMENT=production          # Options: production, staging, development
PORT=8000
SECRET_KEY=generate_a_random_jwt_secret_key_here
REFRESH_TOKEN_SECRET=generate_a_random_refresh_token_secret_here
CORS_ORIGINS=https://jarvis-lyart-mu.vercel.app,https://jarvis-ai-production-eb13.up.railway.app,http://localhost:3000

# --- Production Deployment Endpoints ---
RAILWAY_STATIC_URL=https://jarvis-ai-production-eb13.up.railway.app
VERCEL_URL=https://jarvis-lyart-mu.vercel.app

# --- Database & Caching ---
# SQLite default fallback: sqlite:///./memory/jarvis.db
# PostgreSQL production example: postgresql://user:password@postgres.railway.internal:5432/railway
DATABASE_URL=postgresql://jarvis_user:jarvis_pass@localhost:5432/jarvis_db
REDIS_URL=redis://localhost:6379/0

# --- AI LLM Providers & API Keys ---
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Security, Auth & RBAC ---
JARVIS_API_KEY=your_master_api_key_here
JARVIS_WEB_USERNAME=jarvis-admin
JARVIS_WEB_PASSWORD=set_a_strong_unique_password
JARVIS_WEB_SESSION_SECRET=generate_a_long_random_session_secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Monitoring & Observability ---
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0
LOG_LEVEL=INFO

# --- CI/CD Deployment Hooks ---
RAILWAY_DEPLOY_WEBHOOK=https://backboard.railway.app/deploy/your_hook_id
VERCEL_DEPLOY_HOOK=https://api.vercel.com/v1/integrations/deploy/your_hook_id

# --- Voice & Audio Engine ---
TTS_VOICE=hi-IN-MadhurNeural
WAKE_WORD=jarvis
WHISPER_MODEL=base
