{
  "manifest_version": 3,
  "name": "J.A.R.V.I.S. AI OS Companion",
  "version": "5.5.0",
  "description": "Enterprise Chrome & Edge Extension for JARVIS AI OS: Page Summaries, Translations, AI Email Drafts, Screenshots, Notes & Reading Mode.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://jarvis-ai-production-eb13.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background/service_worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content_script.js"],
      "run_at": "document_idle"
    }
  ]
}
